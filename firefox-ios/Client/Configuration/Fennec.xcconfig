#include "Common.xcconfig"
#include "Debug.xcconfig"
#include "version.xcconfig"

INFOPLIST_FILE = Client/Info.plist
MOZ_BUNDLE_DISPLAY_NAME = Mirlumi Browser
MOZ_BUNDLE_ID = app.mirlumi.browser.dev
// Flag to indicate if we want to include the debug settings bundle or not
INCLUDE_SETTINGS_BUNDLE = YES
MOZ_TODAY_WIDGET_SEARCH_DISPLAY_NAME = Mirlumi - Search
CODE_SIGN_ENTITLEMENTS = Client/Entitlements/FennecApplication.entitlements
CHANNEL = developer
OTHER_SWIFT_FLAGS = $(OTHER_SWIFT_FLAGS_common) -DMOZ_CHANNEL_$(CHANNEL)
MOZ_PUBLIC_URL_SCHEME = mirlumi
MOZ_INTERNAL_URL_SCHEME = mirlumi-dev
OTHER_LDFLAGS = -ObjC -fprofile-instr-generate -Xlinker -no_application_extension
SWIFT_OPTIMIZATION_LEVEL = -Onone
ENABLE_NS_ASSERTIONS = YES

// Mirlumi ships English and Slovenian only; other languages fall back to English.
EXCLUDED_SOURCE_FILE_NAMES = *.lproj/*
INCLUDED_SOURCE_FILE_NAMES = */en.lproj/* */en-US.lproj/* */sl.lproj/* */Base.lproj/*

// Developer-specific signing overrides; see docs/ios-signing.md in the Mirlumi repository.
#include? "Mirlumi.local.xcconfig"
