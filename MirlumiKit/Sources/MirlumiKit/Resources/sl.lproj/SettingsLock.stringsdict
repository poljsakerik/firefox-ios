<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Seconds</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d sekundo</string>
			<key>two</key>
			<string>%d sekundi</string>
			<key>few</key>
			<string>%d sekunde</string>
			<key>other</key>
			<string>%d sekund</string>
		</dict>
	</dict>
	<key>Minutes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d minuto</string>
			<key>two</key>
			<string>%d minuti</string>
			<key>few</key>
			<string>%d minute</string>
			<key>other</key>
			<string>%d minut</string>
		</dict>
	</dict>
	<key>Progress</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Vnesena %1$d števka od %2$d</string>
			<key>two</key>
			<string>Vneseni %1$d števki od %2$d</string>
			<key>few</key>
			<string>Vnesene %1$d števke od %2$d</string>
			<key>other</key>
			<string>Vnesenih %1$d števk od %2$d</string>
		</dict>
	</dict>
</dict>
</plist>
